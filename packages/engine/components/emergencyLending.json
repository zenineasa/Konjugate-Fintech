{
    "copyright": "Copyright © 2026 Zenin Easa Panthakkalakath",
    "id": "emergencyLending",
    "kind": "bundle",
    "name": "Emergency lending",
    "domains": [
        "finance"
    ],
    "description": "A central bank lends reserves to a bank while the bank is short of its reserve target: reserves flow in and the matching borrowing is recorded. The lending is at most the \"Emergency lending\" rate and tapers to nothing as the bank's reserves approach the target, so support ends by itself once the bank is no longer short. One live parameter drives both legs, so one slider (or one fork intervention) is enough. Select the central bank and the bank, then click this bundle.",
    "color": "#9c83c4",
    "endpoints": [
        {
            "id": "centralBank",
            "label": "Central bank"
        },
        {
            "id": "bank",
            "label": "Bank"
        }
    ],
    "sharedParameters": [
        {
            "key": "lending",
            "name": "Emergency lending",
            "symbol": "injection",
            "value": 0,
            "unit": "M/day",
            "mode": "live",
            "control": {
                "minimum": 0,
                "maximum": 100,
                "step": 1
            },
            "scope": "instance"
        },
        {
            "key": "reserveTarget",
            "name": "Reserve target",
            "symbol": "reserveTarget",
            "value": 100,
            "unit": "M",
            "mode": "constant",
            "scope": "project"
        }
    ],
    "edges": [
        {
            "name": "Emergency lending (reserves)",
            "from": "centralBank",
            "to": "bank",
            "bidirectional": true,
            "ports": {
                "source": "reserves",
                "target": "reserves"
            },
            "output": {
                "role": "target",
                "state": "reserves"
            },
            "latex": "\\mathrm{injection} \\cdot \\max\\left(0, 1 - \\frac{\\mathrm{targetReserves}}{\\mathrm{reserveTarget}}\\right)",
            "color": "#9c83c4",
            "parameters": [
                {
                    "name": "Emergency lending",
                    "symbol": "injection",
                    "shared": "lending"
                },
                {
                    "name": "Reserve target",
                    "symbol": "reserveTarget",
                    "shared": "reserveTarget"
                }
            ]
        },
        {
            "name": "Emergency lending (borrowing)",
            "from": "centralBank",
            "to": "bank",
            "ports": {
                "source": "reserves",
                "target": [
                    "borrowing",
                    "reserves"
                ]
            },
            "output": {
                "role": "target",
                "state": "borrowing"
            },
            "latex": "\\mathrm{injection} \\cdot \\max\\left(0, 1 - \\frac{\\mathrm{targetReserves}}{\\mathrm{reserveTarget}}\\right)",
            "color": "#9c83c4",
            "parameters": [
                {
                    "name": "Emergency lending",
                    "symbol": "injection",
                    "shared": "lending"
                },
                {
                    "name": "Reserve target",
                    "symbol": "reserveTarget",
                    "shared": "reserveTarget"
                }
            ]
        }
    ]
}

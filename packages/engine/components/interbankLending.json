{
    "copyright": "Copyright © 2026 Zenin Easa Panthakkalakath",
    "id": "interbankLending",
    "kind": "bundle",
    "name": "Interbank lending",
    "domains": [
        "finance"
    ],
    "description": "The first bank lends to the second whenever it holds more reserves, in proportion to the gap: reserves move across, the lender books an interbank claim, and the borrower books matching borrowing, so both balance sheets stay balanced. Lending only flows one way (no repayment), so apply it once for each direction two banks might lend in. Select the lender first, then the borrower, then click this bundle.",
    "color": "#c48a3f",
    "endpoints": [
        {
            "id": "lender",
            "label": "Lending bank"
        },
        {
            "id": "borrower",
            "label": "Borrowing bank"
        }
    ],
    "sharedParameters": [
        {
            "key": "flowRate",
            "name": "Interbank flow rate",
            "symbol": "flowRate",
            "value": 0.05,
            "unit": "1/day",
            "mode": "constant",
            "scope": "project"
        }
    ],
    "edges": [
        {
            "name": "Interbank lending (reserves)",
            "from": "lender",
            "to": "borrower",
            "bidirectional": true,
            "ports": {
                "source": "reserves",
                "target": "reserves"
            },
            "output": {
                "role": "target",
                "state": "reserves"
            },
            "latex": "\\mathrm{flowRate} \\cdot \\max\\left(0, \\mathrm{sourceReserves} - \\mathrm{targetReserves}\\right)",
            "parameters": [
                {
                    "name": "Flow rate",
                    "symbol": "flowRate",
                    "shared": "flowRate"
                }
            ]
        },
        {
            "name": "Interbank lending (claim)",
            "from": "lender",
            "to": "borrower",
            "ports": {
                "source": [
                    "claims",
                    "reserves"
                ],
                "target": "reserves"
            },
            "output": {
                "role": "source",
                "state": "claims"
            },
            "latex": "\\mathrm{flowRate} \\cdot \\max\\left(0, \\mathrm{sourceReserves} - \\mathrm{targetReserves}\\right)",
            "parameters": [
                {
                    "name": "Flow rate",
                    "symbol": "flowRate",
                    "shared": "flowRate"
                }
            ]
        },
        {
            "name": "Interbank lending (borrowing)",
            "from": "lender",
            "to": "borrower",
            "ports": {
                "source": "reserves",
                "target": [
                    "borrowing",
                    "reserves"
                ]
            },
            "output": {
                "role": "target",
                "state": "borrowing"
            },
            "latex": "\\mathrm{flowRate} \\cdot \\max\\left(0, \\mathrm{sourceReserves} - \\mathrm{targetReserves}\\right)",
            "parameters": [
                {
                    "name": "Flow rate",
                    "symbol": "flowRate",
                    "shared": "flowRate"
                }
            ]
        }
    ]
}

{
    "addonId": "konjugate.fintech.toolbox",
    "name": "Fintech Toolbox",
    "version": "0.1.0",
    "apiVersion": 1,
    "kind": "launcher",
    "entry": "index.html",
    "copyright": "Copyright © 2026 Zenin Easa Panthakkalakath",
    "permissions": [
        "data.import",
        "scenario.run",
        "model.open",
        "results.export",
        "pages.open",
        "analysis.infer",
        "network.fetch"
    ],
    "requires": [
        "scenarioOverrides",
        "runRecord"
    ],
    "contributes": {
        "toolstrip": [
            {
                "commandId": "openFintechToolbox",
                "label": "Fintech",
                "tooltip": "Open the Fintech Toolbox",
                "symbol": "◆",
                "when": "always",
                "contexts": []
            }
        ],
        "importers": [
            {
                "importerId": "balanceSheets",
                "name": "Balance sheets and exposures",
                "entry": "importers/balanceSheet.mjs",
                "files": [
                    {
                        "role": "institutions",
                        "label": "Institutions",
                        "required": true,
                        "accept": [
                            "csv"
                        ],
                        "description": "One row per institution: its balance sheet in millions.",
                        "sample": "samples/institutions.csv"
                    },
                    {
                        "role": "exposures",
                        "label": "Exposures",
                        "required": false,
                        "accept": [
                            "csv"
                        ],
                        "description": "Who has lent to whom: one row per lender, borrower and amount. Optional: without it, exposures are estimated from each institution's interbank totals.",
                        "sample": "samples/exposures.csv"
                    }
                ]
            },
            {
                "importerId": "marketSeries",
                "name": "Market series",
                "entry": "importers/marketSeries.mjs",
                "files": [
                    {
                        "role": "series",
                        "label": "Price or rate series",
                        "required": true,
                        "multiple": true,
                        "accept": [
                            "csv",
                            "txt"
                        ],
                        "description": "One file per series, each with a date column and a price or rate column. Stooq, FRED and Yahoo Finance downloads and most spreadsheet exports work.",
                        "sample": [
                            "samples/Brent crude.csv",
                            "samples/Airlines.csv",
                            "samples/Gold.csv",
                            "samples/Gold miners.csv",
                            "samples/US 10y yield.csv",
                            "samples/Banks.csv",
                            "samples/S&P 500.csv"
                        ]
                    }
                ]
            }
        ],
        "scenarios": [
            {
                "scenarioId": "depositorRun",
                "name": "Depositor run",
                "description": "Depositors withdraw cash from one institution for a week and drain its reserves. Watch the stress spread through interbank lending, fire sales and defaults.",
                "forkAt": 5,
                "runTime": 60,
                "choose": {
                    "label": "Institution under stress"
                },
                "effects": [
                    "For 8 days from day 5, depositors withdraw 1.5% of {entity}'s deposits every day."
                ],
                "interventions": [
                    {
                        "parameter": "withdrawalRate",
                        "target": "chosen",
                        "value": 0.015,
                        "duration": 8
                    }
                ]
            },
            {
                "scenarioId": "runWithPriceShock",
                "name": "Depositor run with a severe asset-price shock",
                "description": "The same run, while forced sales fetch only half of book value. Watch the stress spread through interbank lending, fire sales and defaults, and see who fails.",
                "forkAt": 5,
                "runTime": 60,
                "choose": {
                    "label": "Institution under stress"
                },
                "effects": [
                    "For 8 days from day 5, depositors withdraw 1.5% of {entity}'s deposits every day.",
                    "The haircut on forced sales rises to 50% for every institution: assets sold in a hurry fetch half of book value."
                ],
                "interventions": [
                    {
                        "parameter": "withdrawalRate",
                        "target": "chosen",
                        "value": 0.015,
                        "duration": 8
                    },
                    {
                        "parameter": "baseHaircut",
                        "target": "global",
                        "value": 0.5
                    }
                ]
            },
            {
                "scenarioId": "runWithCentralBankSupport",
                "name": "Run, price shock and central-bank support",
                "description": "The same run and severe price shock as the previous scenario, with the central bank lending to the stressed institution while its cash is below target. Compare the two to see what support is worth.",
                "forkAt": 5,
                "runTime": 60,
                "choose": {
                    "label": "Institution under stress"
                },
                "effects": [
                    "For 8 days from day 5, depositors withdraw 1.5% of {entity}'s deposits every day.",
                    "The haircut on forced sales rises to 50% for every institution.",
                    "From day 8 the central bank lends to {entity} while its cash is below its target: up to half the facility maximum a day, tapering to nothing as cash recovers."
                ],
                "interventions": [
                    {
                        "parameter": "withdrawalRate",
                        "target": "chosen",
                        "value": 0.015,
                        "duration": 8
                    },
                    {
                        "parameter": "baseHaircut",
                        "target": "global",
                        "value": 0.5
                    },
                    {
                        "parameter": "emergencyLending",
                        "target": "chosen",
                        "fractionOfMaximum": 0.5,
                        "at": 3
                    }
                ]
            },
            {
                "scenarioId": "marketWideRun",
                "name": "Market-wide run",
                "description": "Every institution loses deposits at once for ten days: a system-wide loss of confidence rather than a single failure.",
                "forkAt": 5,
                "runTime": 60,
                "effects": [
                    "For 10 days from day 5, depositors withdraw 0.7% of every institution's deposits each day."
                ],
                "interventions": [
                    {
                        "parameter": "withdrawalRate",
                        "target": "all",
                        "value": 0.007,
                        "duration": 10
                    }
                ]
            },
            {
                "scenarioId": "fall",
                "name": "A sharp fall in one series",
                "description": "One series drops 5% in a single bar. See which others follow, and by how much, over the next weeks.",
                "forkAt": 1,
                "runTime": 21,
                "choose": {
                    "label": "Series that falls"
                },
                "effects": [
                    "{entity} falls by about 5% in one bar, at the start of the run.",
                    "Other series move only through the links found in your data."
                ],
                "interventions": [
                    {
                        "parameter": "shock",
                        "target": "chosen",
                        "value": -0.05,
                        "duration": 1
                    }
                ]
            },
            {
                "scenarioId": "rise",
                "name": "A sharp rise in one series",
                "description": "One series jumps 5% in a single bar. See what follows.",
                "forkAt": 1,
                "runTime": 21,
                "choose": {
                    "label": "Series that rises"
                },
                "effects": [
                    "{entity} rises by about 5% in one bar, at the start of the run.",
                    "Other series move only through the links found in your data."
                ],
                "interventions": [
                    {
                        "parameter": "shock",
                        "target": "chosen",
                        "value": 0.05,
                        "duration": 1
                    }
                ]
            },
            {
                "scenarioId": "project",
                "name": "Project forward",
                "description": "Run the model forward from the as-of date with nothing changed, with the range that past volatility allows. Bars held back are drawn against it.",
                "forkAt": 1,
                "runTime": 21,
                "effects": [
                    "Nothing is shocked: each series carries on from its latest move and fades, and the links pass what little movement there is along.",
                    "The range around each path comes from how much the series moved in the range you chose, not from the model."
                ],
                "interventions": [
                    {
                        "parameter": "shock",
                        "target": "all",
                        "value": 0,
                        "duration": 1
                    }
                ]
            },
            {
                "scenarioId": "replay",
                "name": "Replay real moves",
                "description": "Play the real moves of the series you choose after the as-of date through the model, and compare what it expects of the others with what actually happened.",
                "forkAt": 0,
                "runTime": 21,
                "effects": [
                    "The chosen series follow their real moves, bar by bar, from the as-of date.",
                    "Every other series responds only through the links you kept, and is compared with what it really did and with a guess of no change."
                ],
                "interventions": [
                    {
                        "parameter": "trackGain",
                        "target": "supplied",
                        "value": 15
                    },
                    {
                        "parameter": "drive",
                        "target": "supplied",
                        "samples": true
                    }
                ]
            }
        ],
        "pages": [
            {
                "pageId": "gettingStarted",
                "label": "Getting started",
                "entry": "help/gettingStarted.html"
            },
            {
                "pageId": "dataFormat",
                "label": "Data format",
                "entry": "help/dataFormat.html"
            },
            {
                "pageId": "assumptions",
                "label": "Assumptions and limits",
                "entry": "help/assumptions.html"
            },
            {
                "pageId": "marketsGettingStarted",
                "label": "Getting started (Markets)",
                "entry": "help/marketsGettingStarted.html"
            },
            {
                "pageId": "marketsDataFormat",
                "label": "Data format (Markets)",
                "entry": "help/marketsDataFormat.html"
            },
            {
                "pageId": "marketsAssumptions",
                "label": "Assumptions and limits (Markets)",
                "entry": "help/marketsAssumptions.html"
            }
        ]
    },
    "network": {
        "hosts": [
            "query1.finance.yahoo.com",
            "fred.stlouisfed.org",
            "stooq.com"
        ]
    }
}
